{
    id: "deepOriginsOverlays",
    version: 9,
    capabilities: ["FileFilter", "DirFilter"],
    conf: {  
        dirtPathAndFarmlandOverlays: {
            type: "enum",
            default: "default",
            values: ["disabled", "default", "extended"]
        },
        snowLayerOverlays: true,
        connectedSandstone: false
    }
}